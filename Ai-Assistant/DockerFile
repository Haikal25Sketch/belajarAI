# 1. Gunakan base image Python yang ringan
FROM python:3.11-slim

# 2. Atur folder kerja di dalam server sandbox nanti
WORKDIR /app

# 3. Copy file requirements.txt terlebih dahulu untuk instalasi dependensi
COPY requirements.txt .

# 4. Install semua library yang terdaftar di requirements.txt tanpa nyimpen cache sampah
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy seluruh file kodingan AI lu (api.py, agent_graph.py, dll.) ke dalam server
COPY . .

# 6. Jalankan server Uvicorn pas container-nya pertama kali dinyalain
CMD ["uvicorn", "api:app_api", "--host", "0.0.0.0", "--port", "10000"]
